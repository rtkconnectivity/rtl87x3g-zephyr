# RTL87X3G adc configuration

# Copyright(c) 2025, Realtek Semiconductor Corporation.
# SPDX-License-Identifier: Apache-2.0

config ADC_RTL87X3G
   bool "RTL87X3G MCU adc driver"
   default y
   depends on DT_HAS_REALTEK_RTL87X3G_ADC_ENABLED
   select USE_HAL_REALTEK_ADC
   select ADC_ASYNC
   help
     Enable the RTL87X3G adc driver.
