config PINCTRL_RTL87X3G
	bool "RTL87X3G pin controller driver"
	default y
	depends on DT_HAS_REALTEK_RTL87X3G_PINCTRL_ENABLED
	select USE_HAL_REALTEK_PINMUX
	help
	  Enable the RTL87X3G pin controller driver.
