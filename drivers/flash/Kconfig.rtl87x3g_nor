config FLASH_RTL87X3G_NOR
	bool "Enable Realtek RTL87X3G Nor Flash Driver"
	default y
	depends on DT_HAS_REALTEK_RTL87X3G_NOR_FLASH_CONTROLLER_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
	select FLASH_HAS_EXPLICIT_ERASE
	help
	  Enable Realtek RTL87X3G NOR Flash Driver.
