config QDEC_RTL87X3G
	bool "RTL87X3G MCU qdec driver"
	default y
	depends on DT_HAS_REALTEK_RTL87X3G_QDEC_ENABLED
	select USE_HAL_REALTEK_QDEC
	help
	  Enable support for qdec driver for RTL87X3G MCU series.

if QDEC_RTL87X3G

config RTL87X3G_QDEC_X_AXIS_ENABLE
	bool "Enable x axis for RTL87X3G qdec"
	default y
	help
	  If true, enable x aix for RTL87X3G qdec.

config RTL87X3G_QDEC_Y_AXIS_ENABLE
	bool "Enable y axis for RTL87X3G qdec"
	default n
	help
	  If true, enable y aix for RTL87X3G qdec.

config RTL87X3G_QDEC_Z_AXIS_ENABLE
	bool "Enable z axis for RTL87X3G qdec"
	default n
	help
	  If true, enable z aix for RTL87X3G qdec.

endif # QDEC_RTL87X3G
