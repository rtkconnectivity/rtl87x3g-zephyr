config COUNTER_RTC_RTL87X3G
	bool "RTL87X3G rtc counter driver"
	default y if !RTC_RTL87X3G
	depends on DT_HAS_REALTEK_RTL87X3G_RTC_ENABLED
	select USE_HAL_REALTEK_RTC
	help
	  Enable the RTL87X3G counter rtc driver.
