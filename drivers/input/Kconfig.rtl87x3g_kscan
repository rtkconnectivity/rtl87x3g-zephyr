config INPUT_RTL87X3G_KSCAN
	bool "RTL87X3G MCU kscan driver"
	default y
	depends on DT_HAS_REALTEK_RTL87X3G_INPUT_KSCAN_ENABLED
	select USE_HAL_REALTEK_KEYSCAN
	help
	  Enable the RTL87X3G kscan driver.

if INPUT_RTL87X3G_KSCAN
config RTL87X3G_INPUT_KSCAN_MAX_ROW_SIZE
	int "Max row size for RTL87X3G kscan"
	default 12
	help
	  Max row size for RTL87X3G kscan.

config RTL87X3G_INPUT_KSCAN_MAX_COL_SIZE
	int "Max column size for RTL87X3G kscan"
	default 20
	help
	  Max column size for RTL87X3G kscan.

config RTL87X3G_INPUT_KSCAN_GHOST_KEY_FILTER
	bool "Ghost key filter for RTL87X3G kscan"
	default y
	help
	  Ghost key filter for RTL87X3G kscan.

config RTL87X3G_INPUT_KSCAN_AUTOSCAN_MODE
	bool "Config scanmode for RTL87X3G kscan"
	default n
	help
	  Default is manual scan, else is auto scan.

endif # INPUT_RTL87X3G_KSCAN
