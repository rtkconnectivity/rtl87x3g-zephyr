config REALTEK_GRTC_TIMER
	bool "Realtek GRTC timer"
	default y
	depends on DT_HAS_REALTEK_GRTC_TIMER_ENABLED
	select TICKLESS_CAPABLE
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	help
	  This module implements a kernel device driver for the Realtek GRTC timer,
	  and provides the standard "system clock driver" interfaces.
